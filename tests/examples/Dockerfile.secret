# Fixture for --secret tests.
#
# Consumes a build-time secret the same way a real Dockerfile would (writing an
# .npmrc before a package install), then proves the value is gone by the time
# the layer is committed. The secret is mounted by BuildKit/Buildah over the
# build session, so it must not appear in any layer or in build history.

FROM alpine@sha256:4b7ce07002c69e8f3d704a9c5d6fd3053be500b7f1c69fc0d80990c2ad8dd412

WORKDIR /app

# File-backed secret: --secret id=testsecret,src=<file>
RUN --mount=type=secret,id=testsecret \
    test -s /run/secrets/testsecret && \
    grep -q "kimia-secret-canary" /run/secrets/testsecret && \
    echo "file-secret-ok" > /app/file-secret.txt

# Env-backed secret: --secret id=testenv,env=TEST_ENV_SECRET
RUN --mount=type=secret,id=testenv,env=TEST_ENV_SECRET \
    test -n "${TEST_ENV_SECRET}" && \
    echo "env-secret-ok" > /app/env-secret.txt

# The mount is gone once the RUN finishes — nothing should remain on disk.
RUN test ! -e /run/secrets/testsecret && echo "no-leak-ok" > /app/no-leak.txt

CMD ["sh"]
